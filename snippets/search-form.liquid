{% doc %}
  Champ de recherche de produits (en-tête desktop et menu mobile).
  Envoi avec la touche Entrée, comme dans les maquettes.

  @param {string} id - Identifiant unique du champ
  @param {string} placeholder - Texte indicatif

  @example
  {% render 'search-form', id: 'HeaderSearch', placeholder: search_placeholder %}
{% enddoc %}
<form class="search-form" action="{{ routes.search_url }}" method="get" role="search">
  <label class="search-form__field" for="{{ id }}">
    {% render 'icon', name: 'search', size: 18 %}
    <span class="visually-hidden">{{ 'header.search_label' | t }}</span>
    <input
      class="search-form__input"
      id="{{ id }}"
      type="search"
      name="q"
      value="{{ search.terms | escape }}"
      placeholder="{{ placeholder }}"
      autocomplete="off"
    >
  </label>
  <input type="hidden" name="type" value="product">
</form>

{% stylesheet %}
  .search-form__field {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    height: 48px;
    padding: 0 var(--space-4);
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-sm);
    background-color: var(--color-surface-raised);
    color: var(--color-ink);
    cursor: text;
  }

  .search-form__field:focus-within {
    box-shadow: var(--focus-ring);
  }

  .search-form__input {
    flex-grow: 1;
    min-width: 0;
    border: none;
    background: transparent;
    font-size: 16px;
    color: var(--color-ink);
    outline: none;
  }

  .search-form__input:focus-visible {
    box-shadow: none;
  }

  .search-form__input::placeholder {
    color: var(--color-ink-muted);
    opacity: 1;
  }
{% endstylesheet %}
