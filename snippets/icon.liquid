{% doc %}
  Icônes au trait des maquettes, en currentColor. Décoratives (aria-hidden) :
  l'élément parent porte le libellé accessible.

  @param {string} name - search | cart | menu | close | arrow-up | chevron-left | chevron-right | chevron-down | chevron-up | filters | truck | return | lock | bottle | instagram | youtube | tiktok | linkedin
  @param {number} [size] - Taille en pixels (24 par défaut)

  @example
  {% render 'icon', name: 'cart', size: 24 %}
{% enddoc %}
{%- assign size = size | default: 24 -%}
{%- case name -%}
  {%- when 'search' -%}
    <svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>
  {%- when 'cart' -%}
    <svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 8h14l-1 13H6L5 8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
  {%- when 'menu' -%}
    <svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
  {%- when 'close' -%}
    <svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false"><path d="M5 5l14 14M19 5L5 19"/></svg>
  {%- when 'arrow-up' -%}
    <svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" focusable="false"><path d="M5 15l7-7 7 7"/></svg>
  {%- when 'chevron-left' -%}
    <svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false"><path d="M15 5l-7 7 7 7"/></svg>
  {%- when 'chevron-right' -%}
    <svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false"><path d="M9 5l7 7-7 7"/></svg>
  {%- when 'chevron-down' -%}
    <svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false"><path d="M6 9l6 6 6-6"/></svg>
  {%- when 'chevron-up' -%}
    <svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false"><path d="M6 15l6-6 6 6"/></svg>
  {%- when 'filters' -%}
    <svg width="22" height="16" viewBox="0 0 22 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true" focusable="false"><path d="M1 4h12"/><circle cx="16" cy="4" r="2.5"/><path d="M21 12H9"/><circle cx="6" cy="12" r="2.5"/></svg>
  {%- when 'truck' -%}
    <svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2 7h12v9H2z"/><path d="M14 10h4l3 3v3h-7z"/><circle cx="6" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/></svg>
  {%- when 'return' -%}
    <svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M4 12a8 8 0 1 0 2.3-5.7"/><path d="M4 4v4h4"/></svg>
  {%- when 'lock' -%}
    <svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="5" y="10" width="14" height="10" rx="1"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
  {%- when 'bottle' -%}
    <svg width="{{ size }}" height="{{ size | times: 15 | divided_by: 8 }}" viewBox="0 0 80 150" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true" focusable="false"><rect x="28" y="6" width="24" height="22" rx="1"/><rect x="34" y="28" width="12" height="8"/><rect x="10" y="36" width="60" height="104" rx="4"/><rect x="22" y="70" width="36" height="40"/></svg>
  {%- when 'instagram' -%}
    <svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.6" fill="currentColor"/></svg>
  {%- when 'youtube' -%}
    <svg width="{{ size | plus: 2 }}" height="{{ size }}" viewBox="0 0 26 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="2" y="5" width="22" height="14" rx="4"/><path d="M11 9l5 3-5 3z"/></svg>
  {%- when 'tiktok' -%}
    <svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5"/><path d="M14 3c.5 2.8 2.4 4.5 5 4.7"/></svg>
  {%- when 'linkedin' -%}
    <svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true" focusable="false"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M8 10.5V17"/><path d="M8 7.2v.1"/><path d="M12 17v-6.5"/><path d="M12 13.5c0-1.8 1-3 2.5-3s2.5 1 2.5 3V17"/></svg>
{%- endcase -%}
