<div class="password-page full-width">
  <div class="password-page__card">
    <img
      class="password-page__logo"
      src="{{ 'logo-frag-emirates-texte.svg' | asset_url }}"
      alt="Frag Emirates"
      width="138"
      height="60"
    >
    <h1 class="password-page__title">{{ 'password.title' | t }}</h1>

    {%- if shop.password_message != blank -%}
      <p class="lead password-page__message">{{ shop.password_message }}</p>
    {%- endif -%}

    {%- form 'storefront_password', class: 'password-page__form' -%}
      {%- if form.errors -%}
        <div class="password-page__errors" role="alert" id="PasswordErrors">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}
      <label class="password-page__label label" for="PasswordInput">{{ 'password.password' | t }}</label>
      <div class="password-page__row">
        <input
          class="password-page__input"
          type="password"
          name="password"
          id="PasswordInput"
          autocomplete="current-password"
          required
          {% if form.errors %}
            aria-invalid="true" aria-describedby="PasswordErrors"
          {% endif %}
        >
        <button class="button" type="submit">{{ 'password.enter' | t }}</button>
      </div>
    {%- endform -%}
  </div>
</div>

{% stylesheet %}
  .password-page {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100svh;
    padding: var(--space-12) 20px;
  }

  .password-page__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
    width: 100%;
    max-width: 480px;
    text-align: center;
  }

  .password-page__logo {
    width: auto;
    height: 60px;
  }

  .password-page__title {
    font-size: var(--type-display-lg-size);
  }

  .password-page__message {
    color: var(--color-ink-muted);
  }

  .password-page__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    width: 100%;
    text-align: left;
  }

  .password-page__row {
    display: flex;
    gap: var(--space-2);
  }

  .password-page__input {
    flex-grow: 1;
    min-width: 0;
    height: 48px;
    padding: 0 var(--space-4);
    border: 1px solid var(--color-line-strong);
    background-color: var(--color-surface-raised);
    font-size: 16px;
  }

  .password-page__errors {
    padding: var(--space-3) var(--space-4);
    border-left: 2px solid var(--color-sale);
    background-color: var(--color-surface-sand);
    font-size: var(--type-caption-size);
  }

  .password-page__errors ul {
    padding-left: var(--space-4);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Mot de passe",
  "settings": []
}
{% endschema %}
