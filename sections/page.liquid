<div class="page-container page-container--narrow full-width">
  <div class="page-heading">
    <nav class="breadcrumb label" aria-label="{{ 'collections.breadcrumb' | t }}">
      <a href="{{ routes.root_url }}">{{ 'collections.home' | t }}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{{ page.title | escape }}</span>
    </nav>
    <h1>{{ page.title | escape }}</h1>
  </div>

  {%- if page.content != blank -%}
    <div class="rte">{{ page.content }}</div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Page de contenu",
  "settings": []
}
{% endschema %}
