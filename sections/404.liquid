<div class="page-container page-container--narrow not-found full-width">
  <div class="not-found__content">
    <p class="label not-found__label">{{ '404.label' | t }}</p>
    <h1>{{ '404.title' | t }}</h1>
    <p class="lead not-found__text">{{ '404.text' | t }}</p>
    <div class="not-found__actions">
      <a class="button" href="{{ section.settings.collection.url | default: routes.all_products_collection_url }}">
        {{- '404.back_to_shopping' | t -}}
      </a>
      <a class="button button--ghost" href="{{ routes.root_url }}">{{ '404.back_home' | t }}</a>
    </div>
  </div>
</div>

{% stylesheet %}
  .not-found__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-12) 0;
    text-align: center;
  }

  .not-found__label {
    color: var(--color-ink-muted);
  }

  .not-found__text {
    max-width: 480px;
    color: var(--color-ink-muted);
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Page introuvable",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection du bouton principal"
    }
  ]
}
{% endschema %}
